# ig-publisher sozlamalari. Nusxa oling: cp .env.example .env && chmod 600 .env

# --- Login turi ---
# instagram (standart): Instagram Login; facebook: Facebook Login + sahifa (SETUP.md 3b)
IG_LOGIN=instagram
# IG_PAGE_ID=                    # facebook: bir nechta sahifa bo'lsa

# --- Meta app (App Dashboard → Instagram → API setup with Instagram login) ---
# IG_LOGIN=facebook bo'lsa: App settings → Basic dagi App ID / App secret (majburiy)
# Faqat `ig auth url/login` (OAuth) va qisqa tokenni 60 kunlikka almashtirish uchun kerak.
# Dashboard'dan "Generate token" bilan olingan token uchun shart emas.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://localhost/

# Ixtiyoriy: birinchi ishga tushishda DB ga yoziladigan token (yaxshisi `ig auth token` ishlating)
# IG_ACCESS_TOKEN=

# --- Video yuklash ---
# auto: avval to'g'ridan-to'g'ri (resumable), ishlamasa public URL; resumable | url
IG_UPLOAD_MODE=auto

# --- Rasm/cover (va kerak bo'lsa video) uchun public URL berish usuli ---
# tunnel : cloudflared quick tunnel (hech narsa sozlash shart emas)
# static : faylni IG_STATIC_DIR ga ko'chiradi, URL = IG_STATIC_BASE_URL/<nom> (o'z serveringiz)
# command: IG_HOST_COMMAND "$1" faylni yuklab, oxirgi qatorda URL chiqarishi kerak (rclone, aws s3 ...)
IG_HOST=tunnel
# IG_STATIC_DIR=/var/www/ig
# IG_STATIC_BASE_URL=https://media.example.uz/ig
# IG_HOST_COMMAND=rclone copyto "$1" r2:bucket/ig/$(basename "$1") && echo "https://pub.example.r2.dev/ig/$(basename "$1")"

# --- Telegram xabar (ixtiyoriy) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Qo'shimcha ---
# IG_API_VERSION=v26.0
# IG_REFRESH_BEFORE_DAYS=30      # token tugashiga shuncha kun qolganda yangilanadi
# IG_POLL_TIMEOUT_MS=1200000     # Instagram qayta ishlashini kutish (20 daqiqa)
# IG_QUEUE_MAX_ATTEMPTS=3
# FFMPEG_PATH= / FFPROBE_PATH= / CLOUDFLARED_PATH=   # avtomatik topiladi
